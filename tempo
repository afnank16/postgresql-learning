-- ============================================
-- 1. SUBQUERIES
-- Find employees earning more than the average salary
-- ============================================

SELECT employee_name, salary
FROM employees
WHERE salary > (
    SELECT AVG(salary)
    FROM employees
);


-- ============================================
-- 2. CASE WHEN
-- Categorize employees based on salary
-- ============================================

SELECT
    employee_name,
    salary,
    CASE
        WHEN salary >= 80000 THEN 'High Salary'
        WHEN salary >= 50000 THEN 'Medium Salary'
        ELSE 'Low Salary'
    END AS salary_category
FROM employees;


-- ============================================
-- 3. DISTINCT
-- Get unique department IDs from employees
-- ============================================

SELECT DISTINCT department_id
FROM employees;


-- ============================================
-- 4. ALIASES (AS)
-- Rename columns in the output
-- ============================================

SELECT
    employee_name AS name,
    salary AS monthly_salary
FROM employees;


-- ============================================
-- 5. UPDATE WITH CONDITIONS
-- Increase salary for employees in department 1
-- ============================================

UPDATE employees
SET salary = salary * 1.10
WHERE department_id = 1;


-- ============================================
-- 6. ON DELETE CASCADE
-- Automatically delete related records when a parent is deleted
-- ============================================

-- Example setup using separate demo tables
CREATE TABLE demo_departments (
    department_id INT PRIMARY KEY,
    department_name VARCHAR(100)
);

CREATE TABLE demo_employees (
    employee_id INT PRIMARY KEY,
    employee_name VARCHAR(100),
    department_id INT REFERENCES demo_departments(department_id)
        ON DELETE CASCADE
);

-- Insert sample data
INSERT INTO demo_departments VALUES (1, 'IT');

INSERT INTO demo_employees VALUES
    (101, 'Afnan', 1),
    (102, 'Rahul', 1);

-- Deleting the department also deletes its employees
DELETE FROM demo_departments
WHERE department_id = 1;

-- Verify: returns zero rows
SELECT * FROM demo_employees;