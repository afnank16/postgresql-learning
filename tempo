-- 8. Transactions & Indexes

-- 1. BEGIN, COMMIT and ROLLBACK

BEGIN;

UPDATE employees
SET salary = salary + 1000
WHERE employee_id = 1;

COMMIT;

-- Example of ROLLBACK
BEGIN;

UPDATE employees
SET salary = salary + 5000
WHERE employee_id = 1;

ROLLBACK;


-- 2. Understand Database Transactions

-- A transaction groups multiple operations into one unit.
-- Either commit all changes or roll them back.

BEGIN;

UPDATE accounts
SET balance = balance - 1000
WHERE account_id = 1;

UPDATE accounts
SET balance = balance + 1000
WHERE account_id = 2;

COMMIT;


-- 3. CREATE INDEX

-- Create an index on a column
CREATE INDEX idx_employees_name
ON employees(name);

-- Create an index on multiple columns
CREATE INDEX idx_employees_name_salary
ON employees(name, salary);

-- View indexes on a table in psql
\d employees

-- List all indexes in the current database
\di


-- 4. Understand When Indexes Are Useful

-- Query that can benefit from an index
SELECT *
FROM employees
WHERE name = 'Afnan';

-- Query that can benefit from an index
SELECT *
FROM employees
WHERE salary > 50000;

-- Check the query execution plan
EXPLAIN
SELECT *
FROM employees
WHERE name = 'Afnan';

-- Delete an index
DROP INDEX idx_employees_name;

-- Delete the composite index
DROP INDEX idx_employees_name_salary;